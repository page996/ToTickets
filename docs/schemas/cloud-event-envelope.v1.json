    "time": {"type": "string", "format": "date-time"},
    "subject": {"type": "string", "minLength": 1},
    "datacontenttype": {"const": "application/json"},
    "schema": {"type": "string", "format": "uri"},
    "data": {"type": "object"}
  }
}
